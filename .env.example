# Database — Supabase Postgres (free tier). No Docker needed.
# Supabase dashboard → Connect → ORMs → Prisma gives both strings below.
#
# Runtime connection: transaction pooler (port 6543), works with serverless (Vercel).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Migrations: session pooler (port 5432). Prisma Migrate cannot run through pgbouncer.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
#
# Local Postgres alternative (e.g. docker compose up -d) — use the same URL for both:
# DATABASE_URL="postgresql://devquest:devquest@localhost:5432/devquest?schema=public"
# DIRECT_URL="postgresql://devquest:devquest@localhost:5432/devquest?schema=public"

# Auth (NextAuth / Auth.js)
# Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_SUPER_LONG_RANDOM_SECRET________________________________"

# App URL (required in production)
NEXTAUTH_URL="http://localhost:3000"

# Public demo (production only)
# Locks the seeded template project that every demo sandbox is cloned from.
# DEMO_TEMPLATE_LOCKED="true"
# Bearer token Vercel Cron sends to /api/cron/cleanup-guests. Generate like AUTH_SECRET.
# CRON_SECRET=""

# Optional: set to "1" to skip Playwright global database seed (CI workflows seed explicitly)
# E2E_SKIP_SEED=0
