# Database (local Docker Compose)
# DATABASE_URL="postgresql://devquest:devquest@localhost:5432/devquest?schema=public"

# Database (Supabase — replace [PASSWORD] from Dashboard → Settings → Database)
# Direct connection (migrations, seed, Prisma CLI):
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.bxcvfbyuwqgxcuuowfbj.supabase.co:5432/postgres?schema=public"
# Pooler connection (runtime / serverless — append &pgbouncer=true):
# DATABASE_URL="postgresql://postgres.bxcvfbyuwqgxcuuowfbj:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Auth (NextAuth / Auth.js)
# Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_SUPER_LONG_RANDOM_SECRET________________________________"

# App URL (required in production)
NEXTAUTH_URL="http://localhost:3000"

# Optional: set to "1" to skip Playwright global database seed (CI workflows seed explicitly)
# E2E_SKIP_SEED=0
